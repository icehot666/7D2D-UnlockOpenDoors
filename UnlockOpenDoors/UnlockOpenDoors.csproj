<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{FCFB39CB-9FBF-40DD-9491-40EB63FA5822}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>UnlockOpenDoors</RootNamespace>
    <AssemblyName>UnlockOpenDoors</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>11.0</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <TargetFrameworkProfile />

    <!--
      Default Steam installation path.
      Edit this one value for a different Steam library, or override it at build
      time with: /p:GameDir="D:\SteamLibrary\steamapps\common\7 Days To Die"
    -->
    <GameDir Condition=" '$(GameDir)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</GameDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="UnlockOpenDoors.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll')"
           Text="7 Days to Die was not found at '$(GameDir)'. Edit the GameDir property in UnlockOpenDoors.csproj or build with /p:GameDir=&quot;your game folder&quot;." />
    <Error Condition="!Exists('$(GameDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll')"
           Text="UnityEngine.CoreModule.dll was not found beneath '$(GameDir)'." />
    <Error Condition="!Exists('$(GameDir)\Mods\0_TFP_Harmony\0Harmony.dll')"
           Text="0Harmony.dll was not found beneath '$(GameDir)\Mods\0_TFP_Harmony'." />
  </Target>

  <Target Name="CopyModAssembly" AfterTargets="Build">
    <PropertyGroup>
      <ReleaseModDir>$(SolutionDir)Releases\$(AssemblyName)</ReleaseModDir>
      <InstalledModDir>$(GameDir)\Mods\$(AssemblyName)</InstalledModDir>
    </PropertyGroup>

    <MakeDir Directories="$(ReleaseModDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ReleaseModDir)" />

    <!-- Also update an existing local mod installation, but do not create one silently. -->
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(InstalledModDir)"
          Condition="Exists('$(InstalledModDir)')" />
  </Target>
</Project>
